<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/autocomplete_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_autocomplete_badge"
        android:fontFamily="monospace"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#79C0FF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/autocomplete_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textColor="#F0F6FC"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/autocomplete_item_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxWidth="135dp"
        android:singleLine="true"
        android:textColor="#8B949E"
        android:textSize="11sp" />

</LinearLayout>
