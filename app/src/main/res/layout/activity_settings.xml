<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oneui_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include
        android:id="@+id/partial_primary_toolbar"
        layout="@layout/partial_primary_toolbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/oneui_divider" />

    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/oneui_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/oneui_divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/oneui_bottom_nav"
        style="@style/OneUI.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_oneui_bottom_nav" />

</LinearLayout>
