<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/ai_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_action_back"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="#F0F6FC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_assistant_title"
                android:textColor="#F0F6FC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_provider_model_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#79C0FF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ai_context_preview_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_context_preview_title"
            android:padding="12dp"
            android:src="@drawable/ic_tune"
            app:tint="#C9D1D9" />

        <ImageButton
            android:id="@+id/ai_settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_open_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="#C9D1D9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_clear_chat_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="@string/ai_clear_chat"
            android:textAllCaps="false"
            android:textColor="#FF7B72"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D" />

    <!-- Quick Action Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_chip_fix_error"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/ai_quick_fix_error"
                android:textAllCaps="false"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                app:strokeColor="#30363D" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_chip_explain_last"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/ai_quick_explain_last"
                android:textAllCaps="false"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                app:strokeColor="#30363D" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_chip_bash_script"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/ai_quick_write_script"
                android:textAllCaps="false"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                app:strokeColor="#30363D" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_chip_attach_file"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/ai_quick_attach_file"
                android:textAllCaps="false"
                android:textColor="#79C0FF"
                android:textSize="12sp"
                app:strokeColor="#388BFD" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Attached Files Summary Strip -->
    <TextView
        android:id="@+id/ai_attached_files_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#79C0FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Key Missing Warning Banner -->
    <LinearLayout
        android:id="@+id/ai_missing_key_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#332A14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_missing_key_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_missing_key_banner"
            android:textColor="#F2CC60"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_configure_key_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/ai_configure_button"
            android:textAllCaps="false"
            android:textColor="#58A6FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Chat Stream / Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ai_messages_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp" />

        <LinearLayout
            android:id="@+id/ai_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/ai_assistant_title"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="#58A6FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ai_empty_title"
                android:textColor="#F0F6FC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ai_empty_subtitle"
                android:textColor="#8B949E"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D" />

    <!-- Bottom Prompt Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/ai_prompt_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_code_block"
            android:hint="@string/ai_prompt_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="48dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#F0F6FC"
            android:textColorHint="#8B949E"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/ai_send_stop_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ai_fab_pill"
            android:contentDescription="@string/ai_send_prompt"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            app:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
