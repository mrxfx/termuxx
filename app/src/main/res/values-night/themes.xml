<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="colorPrimaryVariant">@color/oneui_surface</item>
        <item name="android:windowBackground">@color/oneui_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">@color/oneui_background</item>
        <item name="termuxActivityDrawerImageTint">@color/oneui_text_primary</item>

        <item name="extraKeysButtonTextColor">@color/oneui_text_primary</item>
        <item name="extraKeysButtonActiveTextColor">@color/oneui_text_primary</item>
        <item name="extraKeysButtonBackgroundColor">@color/oneui_code_background</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/oneui_surface_elevated</item>
    </style>

</resources>
