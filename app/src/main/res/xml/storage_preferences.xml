<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="storage_cat_usage"
        app:title="@string/storage_cat_usage">

        <Preference
            app:key="storage_home_size"
            app:title="@string/storage_home_title"
            app:summary="@string/storage_calculating"
            app:persistent="false" />

        <Preference
            app:key="storage_prefix_size"
            app:title="@string/storage_prefix_title"
            app:summary="@string/storage_calculating"
            app:persistent="false" />

        <Preference
            app:key="storage_ai_history_size"
            app:title="@string/storage_ai_history_title"
            app:summary="@string/storage_calculating"
            app:persistent="false" />

        <Preference
            app:key="storage_ac_history_size"
            app:title="@string/storage_ac_history_title"
            app:summary="@string/storage_calculating"
            app:persistent="false" />

        <Preference
            app:key="storage_studio_backups_size"
            app:title="@string/storage_backups_title"
            app:summary="@string/storage_calculating"
            app:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="storage_cat_actions"
        app:title="@string/storage_cat_actions">

        <Preference
            app:key="storage_clear_caches"
            app:title="@string/storage_clear_caches_title"
            app:summary="@string/storage_clear_caches_summary"
            app:persistent="false" />

        <Preference
            app:key="storage_backup_guide"
            app:title="@string/storage_backup_guide_title"
            app:summary="@string/storage_backup_guide_summary"
            app:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
