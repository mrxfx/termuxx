<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.TermuxApp.DayNight.DarkActionBar"/>
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar"/>

    <!-- Samsung One UI Pure Black & White Primary App Theme -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="colorPrimaryVariant">@color/oneui_surface_elevated</item>
        <item name="colorOnPrimary">@color/oneui_on_accent</item>
        <item name="colorSecondary">@color/oneui_text_secondary</item>
        <item name="colorSecondaryVariant">@color/oneui_surface_secondary</item>
        <item name="colorOnSecondary">@color/oneui_on_accent</item>
        <item name="colorSurface">@color/oneui_surface</item>
        <item name="colorOnSurface">@color/oneui_text_primary</item>
        <item name="android:colorBackground">@color/oneui_background</item>
        <item name="android:windowBackground">@color/oneui_background</item>
        <item name="colorPrimaryDark">@color/oneui_background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:textColorPrimary">@color/oneui_text_primary</item>
        <item name="android:textColorSecondary">@color/oneui_text_secondary</item>
        <item name="android:listDivider">@drawable/oneui_list_divider</item>
        <item name="colorControlActivated">@color/oneui_accent</item>
        <item name="colorControlHighlight">@color/oneui_ripple_light</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TermuxOneUI.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TermuxOneUI.Dialog</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.TermuxOneUI</item>
    </style>

    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- TermuxActivity Pure Black Theme (Preserves terminal rendering & scrollbar) -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="colorPrimaryVariant">@color/oneui_surface</item>
        <item name="android:windowBackground">@color/oneui_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/oneui_background</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">@color/oneui_background</item>
        <item name="termuxActivityDrawerImageTint">@color/oneui_text_primary</item>

        <!-- Extra keys (Clean One UI Black & White) -->
        <item name="extraKeysButtonTextColor">@color/oneui_text_primary</item>
        <item name="extraKeysButtonActiveTextColor">@color/oneui_text_primary</item>
        <item name="extraKeysButtonBackgroundColor">@color/oneui_code_background</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/oneui_surface_elevated</item>
    </style>

</resources>
