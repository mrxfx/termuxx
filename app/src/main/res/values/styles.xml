<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/oneui_accent</item>
        <item name="android:colorBackground">@color/oneui_surface_secondary</item>
        <item name="android:textColorPrimary">@color/oneui_text_primary</item>
        <item name="android:textColorSecondary">@color/oneui_text_secondary</item>
    </style>

    <style name="ThemeOverlay.TermuxOneUI.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="colorOnPrimary">@color/oneui_on_accent</item>
        <item name="colorSurface">@color/oneui_surface_secondary</item>
        <item name="colorOnSurface">@color/oneui_text_primary</item>
        <item name="android:background">@color/oneui_surface_secondary</item>
        <item name="android:textColorPrimary">@color/oneui_text_primary</item>
        <item name="android:textColorSecondary">@color/oneui_text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/OneUI.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/OneUI.DialogButton.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/OneUI.DialogButton.Muted</item>
    </style>

    <style name="OneUI.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="OneUI.DialogButton.Muted" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/oneui_text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PreferenceThemeOverlay.TermuxOneUI" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/OneUI.PreferenceCategory</item>
    </style>

    <style name="OneUI.PreferenceCategory" parent="Preference.Category.Material">
        <item name="android:layout">@layout/oneui_preference_category</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/oneui_text_primary</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/oneui_text_primary</item>
    </style>

    <style name="OneUI.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/oneui_accent</item>
        <item name="android:textColor">@color/oneui_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="OneUI.TonalButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/oneui_surface_secondary</item>
        <item name="strokeColor">@color/oneui_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="OneUI.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/oneui_nav_bar_bg</item>
        <item name="itemIconTint">@color/oneui_bottom_nav_color</item>
        <item name="itemTextColor">@color/oneui_bottom_nav_color</item>
        <item name="itemRippleColor">@color/oneui_ripple_light</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>
